<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lanes" Width="416" SizeToContent="Height" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True"
        FontFamily="{DynamicResource Body}" FontSize="15"
        Foreground="{DynamicResource Text}">
  <Window.Resources>

    <!-- iOS-style switch -->
    <Style x:Key="Switch" TargetType="CheckBox">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <Grid Width="51" Height="31" Background="Transparent">
              <Border CornerRadius="15.5" Background="{DynamicResource Seg}"/>
              <Border x:Name="On" CornerRadius="15.5" Background="{DynamicResource Green}" Opacity="0"/>
              <Ellipse x:Name="Knob" Width="27" Height="27" Fill="White" HorizontalAlignment="Left" Margin="2,0,0,0">
                <Ellipse.RenderTransform><TranslateTransform/></Ellipse.RenderTransform>
                <Ellipse.Effect><DropShadowEffect BlurRadius="6" ShadowDepth="1.5" Direction="270" Opacity="0.28"/></Ellipse.Effect>
              </Ellipse>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Trigger.EnterActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="Knob" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" To="20" Duration="0:0:0.22">
                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                      </DoubleAnimation>
                      <DoubleAnimation Storyboard.TargetName="On" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.22"/>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="Knob" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" To="0" Duration="0:0:0.22">
                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                      </DoubleAnimation>
                      <DoubleAnimation Storyboard.TargetName="On" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.22"/>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.ExitActions>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Primary" TargetType="Button">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Face" CornerRadius="12" Background="{DynamicResource Accent}" Padding="0,11">
              <ContentPresenter HorizontalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Face" Property="Opacity" Value="0.88"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Face" Property="Opacity" Value="0.5"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="CardBox" TargetType="Border">
      <Setter Property="CornerRadius" Value="14"/>
      <Setter Property="Background" Value="{DynamicResource Card}"/>
    </Style>
    <Style x:Key="SubText" TargetType="TextBlock">
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Foreground" Value="{DynamicResource Sub}"/>
    </Style>
    <!-- Window buttons: top-right like Windows, drawn the Apple way (rounded, quiet until hovered). -->
    <Style x:Key="WindowButton" TargetType="Button">
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Foreground" Value="{DynamicResource Sub}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Face" Width="30" Height="30" CornerRadius="9" Background="Transparent">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Face" Property="Background" Value="{DynamicResource Seg}"/>
                <Setter Property="Foreground" Value="{DynamicResource Text}"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="Face" Property="Opacity" Value="0.7"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="CloseWindowButton" TargetType="Button" BasedOn="{StaticResource WindowButton}">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Face" Width="30" Height="30" CornerRadius="9" Background="Transparent">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Face" Property="Background" Value="#FF3B30"/>
                <Setter Property="Foreground" Value="White"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="Face" Property="Opacity" Value="0.8"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <!-- A bare clickable area (segment cells): a real button, so keyboard and UI Automation reach it. -->
    <Style x:Key="PlainButton" TargetType="Button">
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Foreground" Value="{DynamicResource Text}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="Transparent"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <!-- Text-only accent button (back). -->
    <Style x:Key="LinkButton" TargetType="Button">
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Face" Background="Transparent" Padding="0,4"><ContentPresenter/></Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Face" Property="Opacity" Value="0.75"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <!-- Small grey pill button inside a row. -->
    <Style x:Key="PillButton" TargetType="Button">
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
      <Setter Property="FontSize" Value="13.5"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Face" CornerRadius="14" Background="{DynamicResource Seg}" Padding="14,5"><ContentPresenter/></Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Face" Property="Opacity" Value="0.8"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="SectionHeader" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="Foreground" Value="{DynamicResource Sub}"/>
      <Setter Property="Margin" Value="18,18,0,7"/>
    </Style>
    <Style x:Key="RowTitle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="16"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="FontWeight" Value="Medium"/>
    </Style>
    <Style x:Key="RowSub" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="Foreground" Value="{DynamicResource Sub}"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="Margin" Value="0,2,0,0"/>
    </Style>
  </Window.Resources>

  <!-- The margin leaves room for the drop shadow outside the rounded window. -->
  <Border Margin="18" CornerRadius="16" Background="{DynamicResource Bg}" BorderBrush="{DynamicResource Stroke}" BorderThickness="1">
    <Border.Effect><DropShadowEffect BlurRadius="26" ShadowDepth="8" Direction="270" Opacity="0.4" Color="Black"/></Border.Effect>
    <StackPanel Margin="16,14,16,16">

      <!-- Header: drag anywhere on it; the buttons take their own clicks. -->
      <Grid x:Name="Header" Background="Transparent">
        <StackPanel x:Name="MainTitle" Margin="4,8,0,0">
          <TextBlock Text="Lanes" FontFamily="{DynamicResource Display}" FontSize="26" FontWeight="Bold"/>
          <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
            <Ellipse x:Name="Dot" Width="8" Height="8" Fill="{DynamicResource Sub}" VerticalAlignment="Center" Margin="0,1,7,0"/>
            <TextBlock x:Name="Status" Style="{StaticResource SubText}" Text="{DynamicResource T.status.starting}"/>
          </StackPanel>
        </StackPanel>
        <StackPanel x:Name="SettingsTitle" Margin="4,0,0,0" Visibility="Hidden">
          <Button x:Name="BackButton" Style="{StaticResource LinkButton}" HorizontalAlignment="Left">
            <StackPanel Orientation="Horizontal">
              <Path Data="M6,0 L0,6 L6,12" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" VerticalAlignment="Center" Margin="0,0,6,0"/>
              <TextBlock Text="{DynamicResource T.nav.back}" FontSize="15"/>
            </StackPanel>
          </Button>
          <TextBlock Text="{DynamicResource T.settings.title}" FontFamily="{DynamicResource Display}" FontSize="26" FontWeight="Bold" Margin="0,2,0,0"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-4,-6,0">
          <Button x:Name="SettingsButton" Style="{StaticResource WindowButton}" ToolTip="{DynamicResource T.tip.settings}" Margin="0,0,2,0">
            <Grid>
              <TextBlock Text="&#xE713;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14"/>
              <!-- A new release was found; shown by RenderUpdate. -->
              <Ellipse x:Name="UpdateDot" Width="7" Height="7" Fill="{DynamicResource Accent}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-2,-4,0" Visibility="Collapsed"/>
            </Grid>
          </Button>
          <Button x:Name="MinimizeButton" Style="{StaticResource WindowButton}" ToolTip="{DynamicResource T.tip.minimize}" Margin="0,0,2,0">
            <Path Data="M0,0.5 L10,0.5" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4" SnapsToDevicePixels="True"/>
          </Button>
          <Button x:Name="CloseButton" Style="{StaticResource CloseWindowButton}" ToolTip="{DynamicResource T.tip.close}">
            <Path Data="M0,0 L10,10 M10,0 L0,10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
          </Button>
        </StackPanel>
      </Grid>

      <!-- Both pages share one cell. The main page sets the height; the settings page scrolls within it. -->
      <Grid>
        <StackPanel x:Name="MainPage" VerticalAlignment="Top">
          <!-- Shown instead of the speed when the client is not connected -->
          <Border x:Name="Notice" Style="{StaticResource CardBox}" Padding="18,16" Margin="0,14,0,0" Visibility="Collapsed">
            <StackPanel>
              <TextBlock x:Name="NoticeText" TextWrapping="Wrap" FontSize="14" LineHeight="21"/>
              <Button x:Name="NoticeButton" Style="{StaticResource Primary}" Margin="0,12,0,0"/>
            </StackPanel>
          </Border>

          <Border x:Name="SpeedCard" Style="{StaticResource CardBox}" Padding="18,14,18,14" Margin="0,14,0,0">
            <StackPanel>
              <DockPanel>
                <!-- Total / per-thread switch -->
                <Border DockPanel.Dock="Right" CornerRadius="7" Background="{DynamicResource Seg}" Padding="2" VerticalAlignment="Center">
                  <Grid Width="104" Height="22">
                    <Border x:Name="ViewThumb" CornerRadius="5" Background="{DynamicResource Thumb}" Width="52" HorizontalAlignment="Left">
                      <Border.RenderTransform><TranslateTransform/></Border.RenderTransform>
                    </Border>
                    <UniformGrid Rows="1">
                      <Button x:Name="ViewTotal" Style="{StaticResource PlainButton}"><TextBlock Text="{DynamicResource T.view.total}" FontSize="12" FontWeight="SemiBold"/></Button>
                      <Button x:Name="ViewThreads" Style="{StaticResource PlainButton}"><TextBlock Text="{DynamicResource T.view.threads}" FontSize="12" FontWeight="SemiBold"/></Button>
                    </UniformGrid>
                  </Grid>
                </Border>
                <TextBlock x:Name="SpeedLabel" Style="{StaticResource SubText}" Text="{DynamicResource T.speed.label}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
              </DockPanel>
              <!-- Both views share one cell; the thread list is held to the total view's height. -->
              <Grid>
                <StackPanel x:Name="TotalView" VerticalAlignment="Top">
                  <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                    <TextBlock x:Name="Speed" Text="0.0" FontFamily="{DynamicResource Display}" FontSize="48" FontWeight="SemiBold"/>
                    <TextBlock Text="MB/s" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource Sub}" VerticalAlignment="Bottom" Margin="6,0,0,9"/>
                  </StackPanel>
                  <Grid x:Name="Chart" Height="56" Margin="0,8,0,0" ClipToBounds="False">
                    <Path x:Name="ChartArea">
                      <Path.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                          <GradientStop x:Name="AreaTop" Offset="0"/>
                          <GradientStop x:Name="AreaBottom" Offset="1"/>
                        </LinearGradientBrush>
                      </Path.Fill>
                    </Path>
                    <Path x:Name="ChartLine" Stroke="{DynamicResource Accent}" StrokeThickness="2" StrokeLineJoin="Round"/>
                  </Grid>
                </StackPanel>
                <ScrollViewer x:Name="ThreadView" Focusable="False" Visibility="Hidden" VerticalScrollBarVisibility="Hidden" Height="{Binding ActualHeight, ElementName=TotalView}" VerticalAlignment="Top" Margin="-6,0,-6,0">
                  <UniformGrid x:Name="ThreadCells" Columns="4" VerticalAlignment="Top"/>
                  <!-- A row cut by the bottom edge fades out, which reads as "scroll for more". -->
                  <ScrollViewer.OpacityMask>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                      <GradientStop Color="Black" Offset="0.82"/>
                      <GradientStop Color="Transparent" Offset="1"/>
                    </LinearGradientBrush>
                  </ScrollViewer.OpacityMask>
                </ScrollViewer>
              </Grid>
              <DockPanel Margin="0,10,0,0">
                <TextBlock x:Name="ThreadsNow" DockPanel.Dock="Right" Style="{StaticResource SubText}"/>
                <TextBlock x:Name="Requests" Style="{StaticResource SubText}"/>
              </DockPanel>
            </StackPanel>
          </Border>

          <Border Style="{StaticResource CardBox}" Margin="0,12,0,0">
            <StackPanel>
              <DockPanel Margin="18,14">
                <CheckBox x:Name="Enabled" DockPanel.Dock="Right" Style="{StaticResource Switch}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                <StackPanel>
                  <TextBlock Style="{StaticResource RowTitle}" Text="{DynamicResource T.accel.title}"/>
                  <TextBlock Style="{StaticResource RowSub}" Text="{DynamicResource T.accel.sub}"/>
                </StackPanel>
              </DockPanel>
              <Border Height="1" Background="{DynamicResource Sep}" Margin="18,0,0,0"/>
              <StackPanel Margin="18,14,18,16">
                <TextBlock Style="{StaticResource RowTitle}" Text="{DynamicResource T.threads.title}"/>
                <Border CornerRadius="9" Background="{DynamicResource Seg}" Padding="2" Margin="0,10,0,0">
                  <Grid x:Name="ThreadsSeg" Height="30">
                    <Border x:Name="ThreadsSegThumb" CornerRadius="7" Background="{DynamicResource Thumb}" HorizontalAlignment="Left">
                      <Border.RenderTransform><TranslateTransform/></Border.RenderTransform>
                      <Border.Effect><DropShadowEffect BlurRadius="8" ShadowDepth="2" Direction="270" Opacity="0.16"/></Border.Effect>
                    </Border>
                    <UniformGrid x:Name="ThreadsSegLabels" Rows="1"/>
                  </Grid>
                </Border>
              </StackPanel>
            </StackPanel>
          </Border>
        </StackPanel>

        <ScrollViewer x:Name="SettingsPage" Focusable="False" Visibility="Collapsed" VerticalScrollBarVisibility="Hidden" VerticalAlignment="Top">
          <ScrollViewer.OpacityMask>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
              <GradientStop Color="Black" Offset="0.9"/>
              <GradientStop Color="Transparent" Offset="1"/>
            </LinearGradientBrush>
          </ScrollViewer.OpacityMask>
          <StackPanel Margin="0,0,0,44">
            <TextBlock Style="{StaticResource SectionHeader}" Margin="18,12,0,7" Text="{DynamicResource T.settings.general}"/>
            <Border Style="{StaticResource CardBox}">
              <StackPanel>
                <StackPanel Margin="18,14,18,16">
                  <TextBlock Style="{StaticResource RowTitle}" Text="{DynamicResource T.settings.language}"/>
                  <Border CornerRadius="9" Background="{DynamicResource Seg}" Padding="2" Margin="0,10,0,0">
                    <Grid x:Name="LanguageSeg" Height="30">
                      <Border x:Name="LanguageSegThumb" CornerRadius="7" Background="{DynamicResource Thumb}" HorizontalAlignment="Left">
                        <Border.RenderTransform><TranslateTransform/></Border.RenderTransform>
                        <Border.Effect><DropShadowEffect BlurRadius="8" ShadowDepth="2" Direction="270" Opacity="0.16"/></Border.Effect>
                      </Border>
                      <UniformGrid x:Name="LanguageSegLabels" Rows="1"/>
                    </Grid>
                  </Border>
                </StackPanel>
                <Border Height="1" Background="{DynamicResource Sep}" Margin="18,0,0,0"/>
                <DockPanel Margin="18,14">
                  <CheckBox x:Name="AutoStart" DockPanel.Dock="Right" Style="{StaticResource Switch}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                  <StackPanel>
                    <TextBlock Style="{StaticResource RowTitle}" Text="{DynamicResource T.settings.autoStart}"/>
                    <TextBlock Style="{StaticResource RowSub}" Text="{DynamicResource T.settings.autoStart.sub}"/>
                  </StackPanel>
                </DockPanel>
                <Border Height="1" Background="{DynamicResource Sep}" Margin="18,0,0,0"/>
                <DockPanel Margin="18,14">
                  <CheckBox x:Name="CloseToTray" DockPanel.Dock="Right" Style="{StaticResource Switch}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                  <StackPanel>
                    <TextBlock Style="{StaticResource RowTitle}" Text="{DynamicResource T.settings.closeToTray}"/>
                    <TextBlock Style="{StaticResource RowSub}" Text="{DynamicResource T.settings.closeToTray.sub}"/>
                  </StackPanel>
                </DockPanel>
              </StackPanel>
            </Border>

            <TextBlock Style="{StaticResource SectionHeader}" Text="{DynamicResource T.settings.bilibili}"/>
            <Border Style="{StaticResource CardBox}">
              <StackPanel>
                <DockPanel Margin="18,14">
                  <CheckBox x:Name="RestartRunning" DockPanel.Dock="Right" Style="{StaticResource Switch}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                  <StackPanel>
                    <TextBlock Style="{StaticResource RowTitle}" Text="{DynamicResource T.settings.restartRunning}"/>
                    <TextBlock Style="{StaticResource RowSub}" Text="{DynamicResource T.settings.restartRunning.sub}"/>
                  </StackPanel>
                </DockPanel>
                <Border Height="1" Background="{DynamicResource Sep}" Margin="18,0,0,0"/>
                <StackPanel Margin="18,14,18,16">
                  <TextBlock Style="{StaticResource RowTitle}" Text="{DynamicResource T.settings.region}"/>
                  <TextBlock Style="{StaticResource RowSub}" Text="{DynamicResource T.settings.region.sub}"/>
                  <Border CornerRadius="9" Background="{DynamicResource Seg}" Padding="2" Margin="0,10,0,0">
                    <Grid x:Name="RegionSeg" Height="30">
                      <Border x:Name="RegionSegThumb" CornerRadius="7" Background="{DynamicResource Thumb}" HorizontalAlignment="Left">
                        <Border.RenderTransform><TranslateTransform/></Border.RenderTransform>
                        <Border.Effect><DropShadowEffect BlurRadius="8" ShadowDepth="2" Direction="270" Opacity="0.16"/></Border.Effect>
                      </Border>
                      <UniformGrid x:Name="RegionSegLabels" Rows="1"/>
                    </Grid>
                  </Border>
                </StackPanel>
              </StackPanel>
            </Border>

            <TextBlock Style="{StaticResource SectionHeader}" Text="{DynamicResource T.settings.about}"/>
            <Border Style="{StaticResource CardBox}">
              <StackPanel>
                <DockPanel Margin="18,14">
                  <Button x:Name="UpdateButton" DockPanel.Dock="Right" Style="{StaticResource PillButton}" VerticalAlignment="Center" Margin="12,0,0,0">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="&#xE72C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center" Margin="0,1,6,0"/>
                      <TextBlock x:Name="UpdateButtonText" Text="{DynamicResource T.update.check}"/>
                    </StackPanel>
                  </Button>
                  <StackPanel>
                    <TextBlock x:Name="VersionText" Style="{StaticResource RowTitle}" Text="Lanes"/>
                    <TextBlock x:Name="UpdateStatus" Style="{StaticResource RowSub}" Visibility="Collapsed"/>
                  </StackPanel>
                </DockPanel>
                <Border Height="1" Background="{DynamicResource Sep}" Margin="18,0,0,0"/>
                <DockPanel Margin="18,14">
                  <Button x:Name="OpenLog" DockPanel.Dock="Right" Style="{StaticResource PillButton}" VerticalAlignment="Center" Margin="12,0,0,0">
                    <TextBlock Text="{DynamicResource T.settings.log.open}"/>
                  </Button>
                  <StackPanel>
                    <TextBlock Style="{StaticResource RowTitle}" Text="{DynamicResource T.settings.log}"/>
                    <TextBlock Style="{StaticResource RowSub}" Text="{DynamicResource T.settings.log.sub}"/>
                  </StackPanel>
                </DockPanel>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </Grid>

    </StackPanel>
  </Border>
</Window>
